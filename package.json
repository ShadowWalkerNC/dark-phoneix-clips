{
  "name": "ryans-clips-site",
  "version": "1.0.0",
  "description": "Dark Phoneix gaming clips portal and live status dashboard",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "dev:client": "vite --config client/vite.config.mjs",
