PORT=3000
BASE_URL=http://localhost:3000

# Admin console login (/admin). Configure privately in Railway Variables (or local .env).
ADMIN_USER=
ADMIN_PASS=
# API/script key for curl (optional)
ADMIN_KEY=

# Persistent data dir. On Railway: mount a volume at /data and set DATA_DIR=/data.
# Locally: leave unset (uses ./data).
# DATA_DIR=/data

# Twitch Credentials (see RYAN_SETUP.md)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=
TWITCH_BROADCASTER_ID=
TWITCH_EVENTSUB_SECRET=

# YouTube Credentials (see RYAN_SETUP.md)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
# Optional: signs YouTube WebSub push notifications. Leave unset to accept unsigned.
# YOUTUBE_WEBSUB_SECRET=

# Discord live/new-video alerts (see RYAN_SETUP.md)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
